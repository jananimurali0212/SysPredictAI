# Application Configuration
APP_NAME="AI-Powered Real-Time System Monitoring Platform"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Telemetry cadence & retention
METRICS_INTERVAL_SECONDS=1.0
HISTORY_RETENTION_HOURS=24
PROCESS_LIMIT=50

# Database
DATABASE_PATH="system_metrics.db"
DB_PRAGMA_WAL=true

# Logging
LOG_LEVEL="INFO"

# ML & Anomaly Detection
MODEL_DIR="saved_models"
ML_MIN_TRAINING_SAMPLES=30
ANOMALY_CPU_WARNING=75.0
ANOMALY_CPU_CRITICAL=90.0
ANOMALY_MEMORY_WARNING=80.0
ANOMALY_MEMORY_CRITICAL=92.0
ANOMALY_DISK_WARNING=85.0
ANOMALY_DISK_CRITICAL=95.0
ANOMALY_NET_SPEED_SPIKE_BPS=50000000.0
ISOLATION_FOREST_CONTAMINATION=0.05

# Gemini AI Insights
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

